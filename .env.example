# NHS PCA Pipeline - Environment Variables Template
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# Azure Blob Storage
BLOB_CONN_STRING=your_azure_storage_connection_string_here
BLOB_ACCOUNT_KEY=your_azure_storage_account_key_here
BLOB_STORAGE_NAME=your_azure_storage_account_name_here

# PySpark Configuration
PYSPARK_PYTHON=path_to_your_python_executable
PYSPARK_DRIVER_PYTHON=path_to_your_python_executable

# Azure SQL Database
SQL_SERVER=name_of_your_sql_server.database.windows.net
SQL_DATABASE=name_of_your_sql_database  
SQL_USERNAME=your_sql_username_here
SQL_PASSWORD=your_sql_password_here 
